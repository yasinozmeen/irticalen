---
import type { Dictionary, Locale } from '../i18n';

interface Props {
  dict: Dictionary;
  locale: Locale;
  /** Path of this same page in the other locale, for the bottom-line language link. */
  otherLocalePath?: string;
}

const { dict, locale, otherLocalePath } = Astro.props;
const { about, footer } = dict;
const whyPath = locale === 'tr' ? '/neden/' : '/en/why/';
const langHref = otherLocalePath ?? (locale === 'tr' ? '/en/' : '/');
const langLabel = dict.language.switchTo;
---

<footer class="site-footer" data-outside-app>
  <div class="site-footer-grid">
    <div class="site-footer-col site-footer-word">
      <h2 class="footer-heading">{footer.wordHeading}</h2>
      <dl class="word-card">
        <dt>
          <span class="word-term" lang="tr">{about.word.term}</span>
          <span class="word-pron">{about.word.pronunciation}</span>
        </dt>
        <dd class="word-kind">{about.word.kind}</dd>
        <dd class="word-def">{about.word.definition}</dd>
        <dd class="word-example">{about.word.example}</dd>
      </dl>
    </div>

    <div class="site-footer-col site-footer-links">
      <nav aria-label={footer.linksHeading}>
        <ul class="footer-nav-list">
          <li>
            <a class="footer-nav-link" href={whyPath}>
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <circle cx="12" cy="12" r="9" />
                <path d="M9.3 9.6a2.7 2.7 0 1 1 3.9 2.4c-1 .5-1.5 1.1-1.5 2.3" />
                <path d="M11.6 17.5h.1" stroke-linecap="round" />
              </svg>
              {footer.why}
            </a>
          </li>
          <li>
            <a class="footer-nav-link" href="https://yasinozmeen.me" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" />
                <rect x="14" y="3" width="7" height="7" />
                <rect x="3" y="14" width="7" height="7" />
                <rect x="14" y="14" width="7" height="7" />
              </svg>
              {footer.projects}
            </a>
          </li>
          <li>
            <a class="footer-nav-link" href="https://x.com/yasinozmeen" target="_blank" rel="me noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <line x1="5" y1="5" x2="19" y2="19" />
                <line x1="19" y1="5" x2="5" y2="19" />
              </svg>
              {footer.x}
            </a>
          </li>
          <li>
            <a class="footer-nav-link" href="https://github.com/yasinozmeen/irticalen" rel="noopener">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <path d="M8 6l-5 6 5 6M16 6l5 6-5 6" />
              </svg>
              {footer.github}
            </a>
          </li>
          <li class="footer-nav-item-coffee">
            <a class="about-coffee" href="https://buymeacoffee.com/yasinozmeen" target="_blank" rel="noopener noreferrer">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
                <path d="M4 9h13v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5zM17 10h2a2 2 0 0 1 0 5h-2M8 3v3M12 3v3" />
              </svg>
              {about.coffee}
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <p class="footer-bottom">
    {footer.madeBy}
    {' · '}
    <a class="footer-lang-link" href={langHref}>{langLabel}</a>
  </p>
</footer>
