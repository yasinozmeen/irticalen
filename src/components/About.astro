---
import type { Dictionary, Locale } from '../i18n';

interface Props {
  dict: Dictionary;
  locale: Locale;
}

const { dict, locale } = Astro.props;
const { about } = dict;
const whyPath = locale === 'tr' ? '/neden/' : '/en/why/';
---

<section class="about-section" data-outside-app>
  <h2 class="about-heading">{about.heading}</h2>
  {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  <p><a class="about-why-link" href={whyPath}>{dict.footer.why}</a></p>
  <p class="about-inspired">{about.inspiredBy}</p>
</section>
