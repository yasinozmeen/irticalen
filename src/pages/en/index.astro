---
import Base from '../../layouts/Base.astro';
import App from '../../components/App';
import { dictionaries } from '../../i18n';

const locale = 'en' as const;
const dict = dictionaries[locale];
---

<Base locale={locale}>
  <App client:load locale={locale} />

  <section class="about-section" data-outside-app>
    <h2 class="about-heading">{dict.about.heading}</h2>
    {dict.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <p class="about-inspired">{dict.about.inspiredBy}</p>
    <p>
      <a class="about-source" href="https://github.com/yasinozmeen/irticalen" rel="noopener noreferrer">
        {dict.about.source}
      </a>
    </p>
  </section>
</Base>
